# FormGenius AI - Environment Configuration Variables

# Spring Boot Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/formgenius
SPRING_DATASOURCE_USERNAME=formgenius
SPRING_DATASOURCE_PASSWORD=formgenius_secret
POSTGRES_DB=formgenius
POSTGRES_USER=formgenius
POSTGRES_PASSWORD=formgenius_secret

# JWT Authentication
JWT_SECRET=c2VjdXJla2V5MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google Gemini AI Integration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Frontend API Base URL
VITE_API_BASE_URL=/api/v1
